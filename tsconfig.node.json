{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "@jetbrains/youtrack-workflow-types/scripting-api"]
  },
  "include": ["scripts/**/*.ts", "test/**/*.ts", "src/**/*.ts", "vitest.config.ts", "vitest.contract.config.ts"],
  "exclude": ["src/globals.d.ts"]
}
